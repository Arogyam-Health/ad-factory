# =============================================================================
# Ad Factory - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.

# --- Deployment ---
# DEPLOYMENT_MODE=production   # uncomment for production
DEPLOYMENT_MODE=development

# --- MongoDB ---
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ad-factory?retryWrites=true&w=majority
MONGODB_DB_NAME=ad_factory

# --- App Security ---
APP_SECRET_KEY=change-me-in-production-use-a-real-secret
ENCRYPTION_KEY=change-me-32-char-minimum-encryption-key!

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4090/api/auth/google/callback

# --- CORS / Frontend ---
FRONTEND_ORIGIN=http://localhost:4090
CORS_ORIGINS=http://localhost:4090,http://127.0.0.1:4090

# --- Session ---
SESSION_EXPIRE_MINUTES=1440
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Image storage ---
# All generated images and output files are stored locally on the server filesystem.
# The storage directories are:
#   - generated_images/   (in project root)
#   - output/             (in project root)
#   - dashboard_storage/  (in project root)
# STORAGE_PROVIDER=local   # always local
